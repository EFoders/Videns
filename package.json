{
  "name": "videns",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight live map of the Vigilans picture",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "gen": "node scripts/gen-contract.ts",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run gen && npm run typecheck && npm test && npm run build && node scripts/check-budget.ts",
    "mock-feed": "node tools/mock-feed/server.ts",
    "record": "node tools/mock-feed/record.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "geographiclib-geodesic": "^2.2.0",
    "maplibre-gl": "^6.11.2",
    "milsymbol": "^3.0.4",
    "preact": "^11.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "preact-render-to-string": "^6.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
